   191	    res: dict = {
   192	        "h": h,
   193	        "series_id": series_id,
   194	        "target": spec,
   195	        "frame": frame,
   196	        "folds": folds,
   197	        "min_train": min_train,
   198	        "embargo": embargo,
   199	        "step": step,
   200	    }
