    82	def _block_bootstrap_indices(n: int, block: int, rng: np.random.Generator) -> np.ndarray:
    83	    out = []
    84	    while len(out) < n:
    85	        start = int(rng.integers(0, max(1, n - block + 1)))
    86	        out.extend(range(start, min(start + block, n)))
    87	    return np.asarray(out[:n])
