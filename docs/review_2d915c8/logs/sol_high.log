    75	def make_folds(
    76	    n: int,
    77	    horizon: int,
    78	    n_folds: int = 5,
    79	    min_train_frac: float = 0.6,
    80	    embargo: Optional[int] = None,
    81	    step: Optional[int] = None,
    82	) -> list[dict]:
    83	    """Expanding-window folds as ``{"train": (start, end), "test": (start, end)}`` row ranges.
    84	
    85	    Same purge/embargo rule as :func:`run_walk_forward`: the last ``horizon`` rows of a
    86	    training fold are dropped (their labels overlap the test block) and ``embargo`` extra
    87	    rows separate consecutive folds. Fold *k* trains on everything before its test block,
    88	    so the window expands. Exposed separately because model runners that manage their own
    89	    training loop (e.g. ``experiments/run_neural.py``) need the fold geometry only.
    90	    """
    91	    embargo = horizon if embargo is None else embargo
    92	    min_train = int(n * min_train_frac)
    93	    last = n - horizon
    94	    if step is None:
    95	        region = max(1, last - (min_train + horizon + embargo))
    96	        step = max(horizon, region // max(1, n_folds))
    97	    folds: list[dict] = []
    98	    for a in _fold_starts(n, horizon, min_train, embargo, step, last_origin=n - horizon)[:n_folds]:
    99	        tr_end = a - horizon - embargo
   100	        te_end = min(a + step, last)
   101	        if tr_end < 1 or te_end <= a:
   102	            continue
   103	        folds.append({"train": (0, tr_end), "test": (a, te_end)})
   104	    return folds
