    67	def forward_target(price: pd.Series, spec: TargetSpec) -> pd.Series:
    68	    """Supervised label aligned on the forecast origin index."""
    69	    if spec.kind == "log_return":
    70	        lp = price if spec.price_col == "log_price" else np.log(price)
    71	        if spec.unit == "day":
    72	            return forward_log_return(lp, spec.horizon)
    73	        off = forward_offsets(price.index, spec.horizon)
    74	        y = pd.Series(np.nan, index=price.index, dtype=float)
    75	        for i, steps in enumerate(off):
    76	            if np.isfinite(steps):
    77	                j = i + int(steps)
    78	                y.iloc[i] = lp.iloc[j] - lp.iloc[i]
    79	        return y.rename(f"logret_fwd_{spec.horizon}m")
    80	    # level
    81	    if spec.unit == "day":
    82	        return price.shift(-spec.horizon).rename(f"level_fwd_{spec.horizon}d")
    83	    off = forward_offsets(price.index, spec.horizon)
    84	    y = pd.Series(np.nan, index=price.index, dtype=float)
    85	    for i, steps in enumerate(off):
    86	        if np.isfinite(steps):
    87	            y.iloc[i] = price.iloc[i + int(steps)]
    88	    return y.rename(f"level_fwd_{spec.horizon}m")
    89	
