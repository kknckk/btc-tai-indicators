   115	def write_md(out: dict, path: Path) -> None:
   116	    c = out["config"]
   117	    lines = ["# Baselines — walk-forward results", "",
   118	             f"Panel {out['panel']['start']} → {out['panel']['end']}, seed {c['seed']}, expanding window, "
   119	             f"min_train={c['walk_forward']['min_train']}, step={c['walk_forward']['step']}, "
   120	             f"purge=h, extra embargo={c['walk_forward']['embargo']}. Costs on |Δposition|.", "",
   121	             "Positions: naive = buy&hold (zero-return forecast carries no signal, so B&H is the economic RW "
   122	             "benchmark); har_rv/garch = long-only vol-targeting "
   123	             f"({c['vol_target']['annual_vol']:.0%} ann. vol, max lev {c['vol_target']['max_leverage']}); "
   124	             "xgboost = sign(forecast) long/short. DM-p (ret) = Diebold-Mariano (HLN) on squared return error vs "
   125	             "naive; har_rv/garch forecast zero return, so it is identical to naive (n/a) — their skill is in "
   126	             "the variance table.", "",
   127	             "## Return forecasts (full OOS sample)", "",
   128	             "| model | h | RMSE | MAPE price % | R² OOS vs RW | dir-acc | Sharpe net 10bps | Sharpe net 20bps | MaxDD 20bps | DM-p vs naive (ret) |",
   129	             "|---|---|---|---|---|---|---|---|---|---|"]
   130	    for h, rh in out["horizons"].items():
   131	        for m in MODELS:
   132	            e = rh[m]["metrics"]; pt = e["point"]; ec = e["economic"]
   133	            dm = rh[m]["dm_ret_vs_naive"]
   134	            lines.append(f"| {m} | {h} | {pt['rmse']:.5f} | {pt['mape_price_pct']:.2f} | {_f(pt['r2_oos_vs_rw'])} | "
   135	                         f"{_f(pt['dir_acc'], 3)} | {_f(ec['10bps']['sharpe'], 2)} | {_f(ec['20bps']['sharpe'], 2)} | "
   136	                         f"{_f(ec['20bps']['max_dd'], 2)} | {_f(dm['p'] if dm else None, 3)} |")
   137	    lines += ["", f"## Same, sub-period since {c['eval_start_subperiod']}", "",
   138	              "| model | h | RMSE | R² OOS vs RW | dir-acc | Sharpe net 20bps | MaxDD 20bps |", "|---|---|---|---|---|---|---|"]
   139	    for h, rh in out["horizons"].items():
   140	        for m in MODELS:
   141	            e = rh[m]["metrics_since_2018"]; pt = e["point"]; ec = e["economic"]
   142	            lines.append(f"| {m} | {h} | {pt['rmse']:.5f} | {_f(pt['r2_oos_vs_rw'])} | {_f(pt['dir_acc'], 3)} | "
   143	                         f"{_f(ec['20bps']['sharpe'], 2)} | {_f(ec['20bps']['max_dd'], 2)} |")
   144	    lines += ["", "## Variance forecasts (target: mean daily r² over next h days)", "",
   145	              "naive = trailing-30d mean r². Lower QLIKE is better; DM on QLIKE loss vs naive.", "",
   146	              "| model | h | QLIKE | RMSE vol (daily) | DM stat vs naive | DM-p vs naive |", "|---|---|---|---|---|---|"]
   147	    for h, rh in out["horizons"].items():
   148	        for m in ("naive", "har_rv", "garch"):
   149	            v = rh[m]["metrics"]["vol"]; dm = rh[m]["dm_qlike_vs_naive"]
   150	            lines.append(f"| {m} | {h} | {v['qlike']:.4f} | {v['rmse_vol_daily']:.5f} | "
   151	                         f"{_f(dm['stat'], 2) if dm else 'n/a'} | {_f(dm['p'] if dm else None, 4)} |")
   152	    lines += ["", "## Average rank across horizons (1 = best)", "",
   153	              "| model | avg rank (return MSE) | avg rank (QLIKE) |", "|---|---|---|"]
   154	    r1, r2 = out["avg_rank_return_mse"]["avg_rank"], out["avg_rank_qlike"]["avg_rank"]
   155	    for m in MODELS:
   156	        lines.append(f"| {m} | {_f(r1.get(m), 2)} | {_f(r2.get(m), 2)} |")
   157	    lines += ["", "(ties in return MSE: naive/har_rv/garch share identical zero forecasts, hence equal rank.)", ""]
   158	    for h, rh in out["horizons"].items():
   159	        lines += [f"## XGBoost top-10 features by mean normalised gain — h={h}", "", "| feature | gain share |", "|---|---|"]
   160	        lines += [f"| {k} | {v:.3f} |" for k, v in rh["xgboost"]["top10_features_gain"].items()]
   161	        lines.append("")
   162	    lines += ["## Run info", ""]
   163	    for h, rh in out["horizons"].items():
