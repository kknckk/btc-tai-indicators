    34	def dm_matrix(losses: dict[str, np.ndarray], h: int = 1) -> tuple[pd.DataFrame, pd.DataFrame]:
    35	    """Pairwise DM statistics (row vs column; negative = row better) and p-values."""
    36	    names = list(losses)
    37	    stat = pd.DataFrame(np.nan, index=names, columns=names)
    38	    pval = stat.copy()
    39	    for a in names:
    40	        for b in names:
    41	            if a != b:
    42	                stat.loc[a, b], pval.loc[a, b] = dm_test(losses[a], losses[b], h)
    43	    return stat, pval
