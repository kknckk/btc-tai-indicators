    49	def check_causal(
    50	    feature_fn: FeatureFn, panel: pd.DataFrame, n_probes: int = 5, seed: int = 0, tol: float = 1e-9
    51	) -> list[str]:
    52	    """Truncation-invariance test. Features computed on the panel truncated at day T must equal
    53	    the features of the full panel for all rows <= T. Any future-peeking feature (shift(-k),
    54	    centred windows, full-sample scaling) differs and is returned by name."""
    55	    rng = np.random.default_rng(seed)
    56	    full = feature_fn(panel)
    57	    n = len(panel)
    58	    cuts = rng.integers(int(n * 0.3), n - 2, size=n_probes)
    59	    offenders: set[str] = set()
    60	    for cut in cuts:
    61	        part = feature_fn(panel.iloc[: cut + 1])
    62	        a, b = full.iloc[: cut + 1][part.columns], part
    63	        diff = ((a - b).abs() > tol) & ~(a.isna() & b.isna())
    64	        diff |= a.isna() ^ b.isna()
    65	        offenders |= set(diff.columns[diff.any()])
    66	    return sorted(offenders)
