   220	def summarize(
   221	    frame: pd.DataFrame,
   222	    position_fn: PositionFn,
   223	    costs_bps: tuple[float, ...] = (10, 20),
   224	    since: Optional[str] = None,
   225	    target: TargetSpec | None = None,
   226	    price: pd.Series | None = None,
   227	) -> dict:
   228	    """Point, volatility and economic metrics on (optionally a sub-period of) a result frame."""
   229	    f = frame.loc[since:] if since else frame
   230	    out: dict = {"n_obs": int(len(f)), "start": str(f.index[0].date()), "end": str(f.index[-1].date())}
   231	    if target is not None and target.kind == "level" and price is not None:
   232	        po = price.reindex(f.index).to_numpy()
   233	        out["point"] = point_scores(f["y_true"].to_numpy(), f["y_pred"].to_numpy(), target, po)
   234	    else:
   235	        out["point"] = M.point_metrics(f["y_true"].to_numpy(), f["y_pred"].to_numpy())
   236	    if target is not None and price is not None:
   237	        y = f["y_true"]
   238	        rw = benchmark_rw_values(y.index, price, target)
   239	        nv = benchmark_naive(price, target, y)
   240	        m = y.notna() & f["y_pred"].notna() & rw.notna() & nv.notna()
   241	        err_m = (y[m] - f["y_pred"][m]).to_numpy()
   242	        err_rw = (y[m] - rw[m]).to_numpy()
   243	        err_nv = (y[m] - nv[m]).to_numpy()
   244	        out["vs_benchmarks"] = {
   245	            "mse_model": float(np.mean(err_m ** 2)),
   246	            "mse_rw": float(np.mean(err_rw ** 2)),
   247	            "mse_naive": float(np.mean(err_nv ** 2)),
   248	        }
   249	    if "var_pred" in f:
   250	        out["vol"] = M.vol_metrics(f["rv_true"].to_numpy(), f["var_pred"].to_numpy())
   251	    pos = position_fn(f["y_pred"], f["var_pred"] if "var_pred" in f else None)
   252	    out["economic"] = BT.run_backtest(pos, f["next_ret"], costs_bps)
