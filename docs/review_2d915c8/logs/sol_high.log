    52	def run(cfg: dict, max_folds: int | None = None) -> dict:
    53	    panel = load_panel()
    54	    ret = panel["logret_1"]
    55	    wf = cfg["walk_forward"]
    56	    costs = tuple(cfg["costs_bps"])
    57	    since = cfg["eval_start_subperiod"]
    58	    out: dict = {"config": cfg, "panel": {"start": str(panel.index[0].date()), "end": str(panel.index[-1].date()),
    59	                                           "n_cols": int(panel.shape[1])}, "horizons": {}}
    60	    for h in cfg["horizons"]:
    61	        garch_state: dict = {}
    62	        factories = {
    63	            "naive": (lambda: NaiveRW(ret), _buy_hold),
    64	            "har_rv": (lambda h=h: HarRV(ret, h), _vol_target(cfg)),
    65	            "garch": (lambda h=h: GarchVol(ret, h, garch_state, **cfg["garch"]), _vol_target(cfg)),
    66	            "xgboost": (lambda: XGBForecaster(cfg["xgboost"], cfg["seed"]), sign_position),
    67	        }
    68	        res_h: dict = {}
    69	        frames: dict[str, pd.DataFrame] = {}
    70	        for name, (fac, pos_fn) in factories.items():
    71	            t0 = time.time()
    72	            r = run_walk_forward(panel, h, build_features, fac, min_train=wf["min_train"], embargo=wf["embargo"],
    73	                                 step=wf["step"], position_fn=pos_fn, costs_bps=costs, seed=cfg["seed"],
    74	                                 max_folds=max_folds)
    75	            frames[name] = r["frame"]
    76	            r["frame"].to_parquet(RESULTS / "preds" / f"{name}_h{h}.parquet")
    77	            entry = {"metrics": r["metrics"], "metrics_since_2018": summarize(r["frame"], pos_fn, costs, since),
    78	                     "n_folds": len(r["folds"]), "first_test": r["folds"][0]["test_start"],
    79	                     "last_test": r["folds"][-1]["test_end"], "runtime_s": round(time.time() - t0, 1)}
    80	            if name == "garch":
    81	                entry["fit_failures"] = garch_state.get("failures", 0)
    82	            if name == "har_rv":
    83	                coefs = pd.DataFrame([f["diagnostics"]["coef"] for f in r["folds"]])
    84	                entry["har_coef_mean"] = coefs.mean().to_dict()
    85	            if name == "xgboost":
    86	                g = pd.DataFrame([f["diagnostics"]["gain"] for f in r["folds"]]).fillna(0.0)
    87	                entry["top10_features_gain"] = g.mean().sort_values(ascending=False).head(10).to_dict()
    88	                entry["mean_best_iteration"] = float(np.mean([f["diagnostics"]["best_iteration"] for f in r["folds"]]))
    89	            res_h[name] = entry
    90	            logger.info("h=%d %-8s rmse=%.5f r2=%.4f %.0fs", h, name, entry["metrics"]["point"]["rmse"],
    91	                        entry["metrics"]["point"]["r2_oos_vs_rw"], entry["runtime_s"])
    92	        # Diebold-Mariano
    93	        idx = frames["naive"].index
    94	        se = {m: ((f["y_true"] - f["y_pred"]) ** 2).reindex(idx).to_numpy() for m, f in frames.items()}
    95	        ql = {m: M.qlike(f["rv_true"].reindex(idx).to_numpy(), f["var_pred"].reindex(idx).to_numpy())
    96	              for m, f in frames.items() if "var_pred" in f}
    97	        for m in MODELS:
    98	            res_h[m]["dm_ret_vs_naive"] = dict(zip(("stat", "p"), dm_test(se[m], se["naive"], h))) if m != "naive" else None
    99	            res_h[m]["dm_qlike_vs_naive"] = dict(zip(("stat", "p"), dm_test(ql[m], ql["naive"], h))) if m in ql and m != "naive" else None
   100	        st, pv = dm_matrix(ql, h)
   101	        res_h["dm_matrix_qlike"] = {"stat": st.to_dict(), "p": pv.to_dict()}
   102	        out["horizons"][str(h)] = res_h
   103	        out.setdefault("_mean_se", {})[str(h)] = {m: float(np.mean(v)) for m, v in se.items()}
   104	        out.setdefault("_mean_ql", {})[str(h)] = {m: float(np.mean(v)) for m, v in ql.items()}
   105	    out["avg_rank_return_mse"] = average_rank(list(out["_mean_se"].values())).to_dict()
   106	    out["avg_rank_qlike"] = average_rank(list(out["_mean_ql"].values())).to_dict()
   107	    del out["_mean_se"], out["_mean_ql"]
   108	    return out
