    99	def benchmark_rw_values(index: pd.DatetimeIndex, price_at_origin: pd.Series, spec: TargetSpec) -> pd.Series:
   100	    if spec.kind == "log_return":
   101	        return pd.Series(0.0, index=index)
   102	    return price_at_origin.reindex(index)
