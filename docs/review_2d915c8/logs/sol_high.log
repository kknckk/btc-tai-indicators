   128	def point_scores(
   129	    y_true: np.ndarray, y_pred: np.ndarray, spec: TargetSpec, price_origin: np.ndarray | None = None
   130	) -> dict[str, float]:
   131	    """Point metrics plus OOS R² vs random walk and vs naive when benchmarks are supplied."""
   132	    from evaluation import metrics as M
   133	
   134	    y, yhat = np.asarray(y_true, dtype=float), np.asarray(y_pred, dtype=float)
   135	    m = np.isfinite(y) & np.isfinite(yhat)
   136	    y, yhat = y[m], yhat[m]
   137	    if spec.kind == "log_return":
   138	        out = M.point_metrics(y, yhat)
   139	        rw = np.zeros_like(y)
   140	        out["r2_oos_vs_naive"] = float("nan")
   141	        return out
   142	    # level: RMSE/MAE on levels; MAPE vs true level; RW = carry price at t
   143	    out = {
   144	        "rmse": M.rmse(y, yhat),
   145	        "mae": M.mae(y, yhat),
   146	        "mape_price_pct": float(100.0 * np.mean(np.abs(yhat - y) / np.maximum(np.abs(y), 1e-12))),
   147	        "r2_oos_vs_rw": float("nan"),
   148	        "dir_acc": float("nan"),
   149	    }
   150	    if price_origin is not None:
   151	        po = np.asarray(price_origin, dtype=float)[m]
   152	        rw_hat = po
   153	        sse_m = np.sum((y - yhat) ** 2)
   154	        sse_rw = np.sum((y - rw_hat) ** 2)
   155	        out["r2_oos_vs_rw"] = float(1.0 - sse_m / sse_rw) if sse_rw > 0 else float("nan")
   156	    return out
