   145	def run(cfg: dict, preds_dir: Path, mcs_bootstrap: int = 2000) -> dict:
   146	    horizons_out: dict = {}
   147	    panel_meta: dict = {}
   148	    baselines_path = RESULTS / "baselines.json"
   149	    baselines = json.loads(baselines_path.read_text()) if baselines_path.is_file() else {}
   150	    panel_meta = baselines.get("panel", {})
   151	
   152	    for h in cfg["horizons"]:
   153	        hs = str(h)
   154	        frames = load_pred_frames(preds_dir, h, ALL_MODELS)
   155	        block: dict = {"economic": {}, "from_baselines": not frames}
   156	
   157	        if frames:
   158	            try:
   159	                _, aligned = align_forecast_frames(frames)
   160	            except ValueError as e:
   161	                logger.warning("h=%s: %s", h, e)
   162	                aligned = frames
   163	            for m, f in aligned.items():
   164	                block["economic"][m] = backtest_on_frame(f, _position_fn(m, cfg), tuple(cfg["costs_bps"]))
   165	            losses = squared_return_losses(aligned)
   166	            block["mcs"] = mcs(losses, n_bootstrap=mcs_bootstrap, seed=cfg["seed"])
   167	            block["from_baselines"] = False
   168	            block["n_common_days"] = len(next(iter(aligned.values())))
   169	            block["models_loaded"] = sorted(aligned)
   170	        elif hs in baselines.get("horizons", {}):
   171	            rh = baselines["horizons"][hs]
   172	            for m in BASELINE_MODELS:
   173	                if m in rh:
   174	                    block["economic"][m] = rh[m]["metrics"]["economic"]
   175	            block["models_loaded"] = BASELINE_MODELS
