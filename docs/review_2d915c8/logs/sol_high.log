   105	def benchmark_naive(
   106	    price: pd.Series, spec: TargetSpec, y_true: pd.Series | None = None
   107	) -> pd.Series:
   108	    """Trailing-mean log-return (default naive for BTC baselines) or lagged level."""
   109	    if spec.kind == "log_return":
   110	        r = price.diff() if spec.price_col == "log_price" else np.log(price).diff()
   111	        mu = r.rolling(spec.naive_window).mean()
   112	        if spec.unit == "day":
   113	            return (mu * spec.horizon).reindex(y_true.index if y_true is not None else price.index)
   114	        off = forward_offsets(price.index, spec.horizon)
   115	        idx = y_true.index if y_true is not None else price.index
   116	        out = pd.Series(np.nan, index=idx, dtype=float)
   117	        for t in idx:
   118	            pos = price.index.get_loc(t)
   119	            if isinstance(pos, slice):
   120	                pos = pos.start
   121	            w = slice(max(0, pos - spec.naive_window + 1), pos + 1)
   122	            out.loc[t] = float(r.iloc[w].mean() * off[pos]) if np.isfinite(off[pos]) else np.nan
   123	        return out
