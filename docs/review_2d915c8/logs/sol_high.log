    19	def mcs(
    20	    losses: dict[str, np.ndarray],
    21	    alpha: float = 0.10,
    22	    n_bootstrap: int = 2000,
    23	    block_size: int | None = None,
    24	    seed: int = 0,
    25	) -> dict:
    26	    """Bootstrap Model Confidence Set (Hansen–Lunde–Nason style sequential elimination).
    27	
    28	    Returns the set of models not rejected at level ``alpha``, bootstrap p-values for elimination,
    29	    and the pairwise DM matrix on the same aligned sample.
    30	    """
    31	    names, L = _loss_matrix(losses)
    32	    if L.shape[0] < 20 or L.shape[1] < 2:
    33	        return {
    34	            "models": names,
    35	            "confidence_set": names,
    36	            "elimination_p": {k: 0.0 for k in names},
    37	            "mean_loss": {k: float(np.mean(L[:, i])) for i, k in enumerate(names)},
    38	            "dm_stat": {},
    39	            "dm_p": {},
    40	        }
    41	    rng = np.random.default_rng(seed)
    42	    T, M = L.shape
    43	    block = block_size or max(1, int(np.ceil(T ** (1 / 3))))
    44	    active = list(range(M))
    45	    elim_p: dict[str, float] = {names[i]: 0.0 for i in range(M)}
    46	
    47	    while len(active) > 1:
    48	        La = L[:, active]
    49	        mean_a = La.mean(axis=0)
    50	        best = int(np.argmin(mean_a))
    51	        rel = La - La[:, [best]]
    52	        t_stats = rel.mean(axis=0) / np.sqrt(np.maximum(rel.var(axis=0, ddof=1) / T, 1e-18))
    53	        t_stats[best] = -np.inf
    54	        worst_local = int(np.argmax(t_stats))
    55	        worst = active[worst_local]
    56	        d = rel[:, worst_local] - rel[:, worst_local].mean()
    57	        boot_max = []
    58	        for _ in range(n_bootstrap):
    59	            idx = _block_bootstrap_indices(T, block, rng)
    60	            db = d[idx]
    61	            boot_max.append(db.mean() / np.sqrt(np.maximum(db.var(ddof=1) / T, 1e-18)))
    62	        stat = float(t_stats[worst_local])
    63	        p = float(np.mean(np.asarray(boot_max) >= stat))
    64	        elim_p[names[worst]] = max(elim_p[names[worst]], p)
    65	        if p <= alpha:
    66	            active = [i for i in active if i != worst]
    67	        else:
    68	            break
    69	
    70	    conf = [names[i] for i in active]
    71	    dm_stat, dm_p = dm_matrix({names[i]: L[:, i] for i in range(M)}, h=1)
    72	    return {
    73	        "models": names,
    74	        "confidence_set": conf,
    75	        "elimination_p": elim_p,
    76	        "mean_loss": {names[i]: float(L[:, i].mean()) for i in range(M)},
    77	        "dm_stat": dm_stat.to_dict(),
    78	        "dm_p": dm_p.to_dict(),
    79	    }
    80	
