    21	from evaluation.walk_forward import run_walk_forward, sign_position, summarize
    22	from experiments.baselines import GarchVol, HarRV, NaiveRW, XGBForecaster
    23	from experiments.config import ROOT, load_config
    24	from experiments.data import build_features, load_panel
    25	
    26	logger = logging.getLogger("baselines")
    27	RESULTS = ROOT / "results"
    28	MODELS = ["naive", "har_rv", "garch", "xgboost"]
    29	
    30	
    31	def _buy_hold(pred, vol=None):
    32	    return buy_hold_position(pred, vol)
    33	
    34	
    35	def _vol_target(cfg):
    36	    vt = cfg["vol_target"]
    37	    return vol_target_position(vt["annual_vol"], vt["max_leverage"], cfg["annualization"])
    38	
    39	
    40	def _clean(o):
    41	    if isinstance(o, dict):
    42	        return {k: _clean(v) for k, v in o.items()}
    43	    if isinstance(o, (list, tuple)):
    44	        return [_clean(v) for v in o]
    45	    if isinstance(o, (np.floating, float)):
    46	        return None if not np.isfinite(o) else float(o)
    47	    if isinstance(o, np.integer):
    48	        return int(o)
    49	    return o
