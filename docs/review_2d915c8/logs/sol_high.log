    10	def _loss_matrix(losses: dict[str, np.ndarray]) -> tuple[list[str], np.ndarray]:
    11	    names = list(losses)
    12	    aligned = [np.asarray(losses[k], dtype=float) for k in names]
    13	    n = min(len(x) for x in aligned)
    14	    L = np.column_stack([x[:n] for x in aligned])
    15	    m = np.all(np.isfinite(L), axis=1)
    16	    return names, L[m]
