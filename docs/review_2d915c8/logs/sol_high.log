   150	    if max_folds:
   151	        starts = starts[:max_folds]
   152	    if not starts:
   153	        raise ValueError("not enough data for a single fold")
   154	
   155	    preds, vols, folds = [], [], []
   156	    for k, a in enumerate(starts):
   157	        tr_end = a - purge - embargo
   158	        te_end = min(a + step, last_origin)
   159	        tr, te = slice(0, tr_end), slice(a, te_end)
   160	        X_tr, y_tr = X_all.iloc[tr], y_all.iloc[tr]
   161	        assert y_tr.notna().all() and tr_end + purge - 1 < a, "label window of the train fold reaches the test block"
   162	        assert X_all.index[tr_end - 1] < X_all.index[a]
