    55	def forward_offsets(index: pd.DatetimeIndex, h_months: int) -> np.ndarray:
    56	    """For each row i, number of rows until the first date >= t_i + h months (NaN if none)."""
    57	    n = len(index)
    58	    out = np.full(n, np.nan)
    59	    for i in range(n):
    60	        tgt = index[i] + pd.DateOffset(months=h_months)
    61	        j = index.searchsorted(tgt, side="left")
    62	        if j < n:
    63	            out[i] = j - i
    64	    return out
