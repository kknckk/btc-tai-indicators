   170	            "fold": k, "train_start": str(X_tr.index[0].date()), "train_end": str(X_tr.index[-1].date()),
   171	            "test_start": str(X_te.index[0].date()), "test_end": str(X_te.index[-1].date()),
   172	            "n_train": int(len(X_tr)), "n_test": int(len(X_te)),
   173	        }
   174	        if hasattr(model, "diagnostics"):
