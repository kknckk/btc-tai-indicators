    46	def average_rank(mean_losses: list[dict[str, float]]) -> pd.DataFrame:
    47	    """Average rank (1 = lowest loss) of each model across a list of loss tables
    48	    (e.g. one table per horizon / loss function). Models absent from a table are skipped there."""
    49	    ranks = pd.DataFrame([pd.Series(t).rank(method="average") for t in mean_losses])
    50	    return pd.DataFrame({"avg_rank": ranks.mean(), "n_tables": ranks.notna().sum()}).sort_values("avg_rank")

