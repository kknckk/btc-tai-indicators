     9	def dm_test(loss_a: np.ndarray, loss_b: np.ndarray, h: int = 1) -> tuple[float, float]:
    10	    """Two-sided DM test of equal expected loss. d_t = loss_a - loss_b.
    11	
    12	    Negative statistic => model A has lower loss. Long-run variance uses h-1 autocovariances
    13	    (h-step forecasts are MA(h-1)); the HLN factor sqrt((n+1-2h+h(h-1)/n)/n) is applied and the
    14	    statistic is compared with Student-t(n-1). Returns (stat, p); (nan, nan) if degenerate.
    15	    """
    16	    d = np.asarray(loss_a, dtype=float) - np.asarray(loss_b, dtype=float)
    17	    d = d[np.isfinite(d)]
    18	    n = len(d)
    19	    if n < 10 or np.allclose(d, 0.0):
    20	        return float("nan"), float("nan")
    21	    dc = d - d.mean()
    22	    var = float(dc @ dc / n)
    23	    for k in range(1, h):
    24	        var += 2.0 * float(dc[k:] @ dc[:-k] / n)
    25	    if var <= 0:
    26	        return float("nan"), float("nan")
    27	    stat = d.mean() / np.sqrt(var / n)
    28	    hln = np.sqrt((n + 1 - 2 * h + h * (h - 1) / n) / n)
    29	    stat *= hln
    30	    p = 2.0 * stats.t.sf(abs(stat), df=n - 1)
    31	    return float(stat), float(p)
    32	
