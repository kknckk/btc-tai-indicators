    91	def resolve_price(panel: pd.DataFrame, spec: TargetSpec) -> pd.Series:
    92	    if spec.price_col == "log_price":
    93	        if "log_price" in panel.columns:
    94	            return panel["log_price"]
    95	        return np.log(panel["PriceUSD"])
    96	    return panel[spec.price_col]
