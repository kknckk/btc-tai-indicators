     1	"""Run naive / HAR-RV / GARCH / XGBoost through the walk-forward harness.
     2	
     3	Usage: python -m experiments.run_baselines [--max-folds N]
     4	Writes results/baselines.json, results/baselines.md and results/preds/*.parquet (ignored by git).
     5	"""
     6	from __future__ import annotations
