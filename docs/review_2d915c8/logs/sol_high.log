   205	def run_multi_series(
   206	    panels: dict[str, pd.DataFrame],
   207	    h: int,
   208	    feature_fn: FeatureFn,
   209	    model_factory: Callable[[], Forecaster],
   210	    target: TargetSpec,
   211	    **kwargs,
   212	) -> dict[str, dict]:
   213	    """Run the same walk-forward protocol on several aligned panels (e.g. multi-asset)."""
   214	    return {
   215	        sid: run_walk_forward(p, h, feature_fn, model_factory, target=target, series_id=sid, **kwargs)
   216	        for sid, p in panels.items()
   217	    }
