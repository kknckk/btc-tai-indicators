    69	def _fold_starts(n: int, purge: int, min_train: int, embargo: int, step: int, last_origin: int | None = None) -> list[int]:
    70	    last = last_origin if last_origin is not None else n - purge
    71	    first = min_train + purge + embargo
    72	    return list(range(first, last, step))
