"""Baseline forecasters conforming to ``evaluation.walk_forward.Forecaster``.

Volatility models (naive, HAR-RV, GARCH) take the full return series by closure but only ever
read values at or before the timestamp they forecast from (HAR/naive use trailing windows,
GARCH filters recursively with parameters fitted on the train fold only).
"""
from __future__ import annotations

import logging
import warnings
from typing import Optional

import numpy as np
import pandas as pd
import statsmodels.api as sm
import xgboost as xgb
from arch import arch_model

logger = logging.getLogger(__name__)


class NaiveRW:
    """Random walk: zero return forecast. Variance forecast = trailing 30d mean r^2 (historical vol)."""

    def __init__(self, returns: pd.Series) -> None:
        self.hist_var = (returns ** 2).rolling(30, min_periods=30).mean()

    def fit(self, X: pd.DataFrame, y: pd.Series) -> "NaiveRW":
        return self

    def predict(self, X: pd.DataFrame) -> np.ndarray:
        return np.zeros(len(X))

    def predict_vol(self, X: pd.DataFrame) -> np.ndarray:
        return self.hist_var.reindex(X.index).to_numpy()


class HarRV:
    """HAR-RV (Corsi 2009) on daily realised variance proxy r^2 (no intraday data in repo).

    Regress mean r^2 over (t, t+h] on r^2_t, mean r^2 over 7d and 30d (OLS, levels).
    Return forecast = 0.
    """

    def __init__(self, returns: pd.Series, h: int) -> None:
        r2 = returns ** 2
        self.h = h
        self.r2 = r2
        self.feat = pd.DataFrame({
            "rv_d": r2, "rv_w": r2.rolling(7, min_periods=7).mean(), "rv_m": r2.rolling(30, min_periods=30).mean(),
        })
        self.res = None
        self.floor = 1e-8

    def fit(self, X: pd.DataFrame, y: pd.Series) -> "HarRV":
        h = self.h
        tgt = self.r2.rolling(h).mean().shift(-h).reindex(X.index)  # label window ends <= last train idx + h
        F = self.feat.reindex(X.index)
        m = tgt.notna() & F.notna().all(axis=1)
        self.res = sm.OLS(tgt[m], sm.add_constant(F[m])).fit()
        self.floor = float(tgt[m].quantile(0.01))
        return self

    def predict_vol(self, X: pd.DataFrame) -> np.ndarray:
        F = sm.add_constant(self.feat.reindex(X.index), has_constant="add")
        return np.maximum(self.res.predict(F).to_numpy(), self.floor)

    def predict(self, X: pd.DataFrame) -> np.ndarray:
        return np.zeros(len(X))

    def diagnostics(self) -> dict:
        return {"coef": {k: float(v) for k, v in self.res.params.items()}}


class GarchVol:
    """Zero-mean GARCH(1,1) (o=0) or GJR-GARCH(1,1,1) (o=1). Parameters fitted on the train fold
    (returns x100); variance forecasts for test origins are produced by filtering the fixed model
    recursively, so the forecast at origin t only uses returns <= t. Return forecast = 0.
    ``state`` is shared across folds to fall back on previous parameters if a fit fails."""

    def __init__(self, returns: pd.Series, h: int, state: dict, o: int = 1, dist: str = "t") -> None:
        self.ret = returns * 100.0
        self.h, self.o, self.dist, self.state = h, o, dist, state

    def _model(self, series: pd.Series):
        return arch_model(series, mean="Zero", vol="GARCH", p=1, o=self.o, q=1, dist=self.dist, rescale=False)

    def fit(self, X: pd.DataFrame, y: pd.Series) -> "GarchVol":
        tr = self.ret.reindex(X.index).dropna()
        self.ok = True
        try:
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                res = self._model(tr).fit(disp="off", options={"maxiter": 500})
            if res.convergence_flag != 0 and "params" in self.state:
                raise RuntimeError(f"no convergence (flag {res.convergence_flag})")
            self.state["params"] = res.params
        except Exception as exc:  # noqa: BLE001
            self.ok = False
            self.state["failures"] = self.state.get("failures", 0) + 1
            logger.warning("GARCH fit failed (%s); reusing previous params", exc)
            if "params" not in self.state:
                raise
        return self

    def predict_vol(self, X: pd.DataFrame) -> np.ndarray:
        upto = self.ret.loc[: X.index[-1]].dropna()
        pos0 = upto.index.get_indexer([X.index[0]])[0]
        res = self._model(upto).fix(self.state["params"])
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            f = res.forecast(horizon=self.h, start=pos0, reindex=False, method="analytic")
        v = f.variance.to_numpy().mean(axis=1) / 1e4  # mean daily variance over next h days
        return pd.Series(v, index=f.variance.index).reindex(X.index).to_numpy()

    def predict(self, X: pd.DataFrame) -> np.ndarray:
        return np.zeros(len(X))


class XGBForecaster:
    """XGBoost regressor on h-day log return. Early stopping uses the LAST ``val_fraction`` of the
    train fold only (chronological), the test block is never touched."""

    def __init__(self, params: dict, seed: int = 42) -> None:
        self.p = dict(params)
        self.seed = seed

    def fit(self, X: pd.DataFrame, y: pd.Series) -> "XGBForecaster":
        p = dict(self.p)
        vf, es = p.pop("val_fraction"), p.pop("early_stopping_rounds")
        cut = int(len(X) * (1 - vf))
        self.cols = list(X.columns)
        self.model = xgb.XGBRegressor(
            tree_method="hist", random_state=self.seed, early_stopping_rounds=es, **p
        )
        self.model.fit(X.iloc[:cut], y.iloc[:cut], eval_set=[(X.iloc[cut:], y.iloc[cut:])], verbose=False)
        return self

    def predict(self, X: pd.DataFrame) -> np.ndarray:
        return self.model.predict(X[self.cols])

    def diagnostics(self) -> dict:
        gain = self.model.get_booster().get_score(importance_type="total_gain")
        tot = sum(gain.values()) or 1.0
        return {"best_iteration": int(self.model.best_iteration), "gain": {k: v / tot for k, v in gain.items()}}
"""Data layer: merged daily panel of on-chain metrics + BTC price.

CLI: ``python -m experiments.data --check``
"""
from __future__ import annotations

import argparse
import logging
from pathlib import Path
from typing import Callable, Iterable, Sequence

import numpy as np
import pandas as pd

from experiments.config import ROOT, load_config

logger = logging.getLogger(__name__)

ONCHAIN_DIR = ROOT / "data_ingestion" / "csv"
PRICE_CSV = ROOT / "api" / "csv" / "PriceUSD.csv"
PANEL_PARQUET = ROOT / "data" / "panel.parquet"
ANN = 365
# Several series (NVT*, TxTfrVal*, UTXOCnt, ShareExUSD, BlkSizeMeanByte) are sampled every
# ~4 days; a causal forward-fill of at most this many days makes them usable as daily features.
SPARSE_FFILL = 7

# Columns shipped in data_ingestion/csv that are derived from price. They are kept in the
# panel (nothing is dropped silently) but never used as features.
#   dir_t1 == 1[logret_{t+1} > 0]  -> FORWARD-LOOKING LABEL (verified: 100% sign agreement
#   with next-day return). r_t / rv_* duplicate our own causal logret_1 / rv_*.
PRICE_DERIVED_COLUMNS = frozenset({"dir_t1", "r_t", "rv_t", "rv_7d", "rv_30d"})
FORWARD_LOOKING_COLUMNS = frozenset({"dir_t1"})
# Raw price-level columns: non-stationary, excluded from features (log_price kept in panel).
PRICE_LEVEL_COLUMNS = frozenset({"PriceUSD", "PriceBTC", "log_price"})

# Level-type metrics (positive, growing, heavy tailed) -> signed log1p transform.
LEVEL_COLUMNS = (
    "AdrActCnt AdrBalCnt BlkCnt BlkSizeMeanByte CDD CapFutExp10yrUSD CapMrktCurUSD CapRealUSD "
    "DiffMean FeeMeanNtv FeeMeanUSD FeeMedNtv FeeMedUSD FeeTotNtv FeeTotUSD FlowInExNtv "
    "FlowInExUSD FlowOutExNtv FlowOutExUSD HashRate IssTotNtv IssTotUSD NetFlowNtv NetFlowUSD "
    "RealizedPrice RevAllTimeUSD RevUSD SplyCur SplyExpFut10yr TxCnt TxCntSec TxMeanByte TxTfrCnt "
    "TxTfrValMeanNtv TxTfrValMeanUSD TxTfrValNtv TxTfrValUSD UTXOCnt CapAct1yrUSD SplyAct180d "
    "SplyAct1yr SplyAct30d"
).split()


def signed_log1p(x: pd.Series | np.ndarray) -> pd.Series | np.ndarray:
    """Monotone transform sign(x)*log1p(|x|); equals log1p(x) for x >= 0."""
    return np.sign(x) * np.log1p(np.abs(x))


def _read_series(path: Path) -> pd.Series:
    df = pd.read_csv(path)
    value_col = [c for c in df.columns if c != "time"]
    s = pd.Series(
        df[value_col[0]].to_numpy(dtype=float) if value_col else np.array([], dtype=float),
        index=pd.to_datetime(df["time"], errors="coerce"),
        name=path.stem,
    )
    s = s[s.index.notna()]
    return s[~s.index.duplicated(keep="last")]


def load_panel(start: str | None = None, end: str | None = None) -> pd.DataFrame:
    """Outer-join all on-chain CSVs and PriceUSD on a daily DatetimeIndex.

    Derived columns: ``logret_1``, ``rv_7``, ``rv_30`` (annualised rolling std of
    ``logret_1``, trailing windows only), ``log_price`` and ``slog1p_<metric>`` for every
    level-type metric in ``LEVEL_COLUMNS`` that is present. Every column is causal: value
    at row t uses data up to and including t.
    """
    series: dict[str, pd.Series] = {}
    for path in sorted(ONCHAIN_DIR.glob("*.csv")):
        series[path.stem] = _read_series(path)
    price = _read_series(PRICE_CSV)
    price.name = "PriceUSD"
    series["PriceUSD"] = price  # api/csv copy is identical to data_ingestion/csv/PriceUSD.csv

    panel = pd.concat(series, axis=1, sort=True)
    panel = panel.reindex(pd.date_range(panel.index.min(), panel.index.max(), freq="D"))
    panel.index.name = "time"

    p = panel["PriceUSD"].where(panel["PriceUSD"] > 0)
    panel["log_price"] = np.log(p)
    panel["logret_1"] = panel["log_price"].diff()
    r = panel["logret_1"]
    panel["rv_7"] = r.rolling(7, min_periods=7).std() * np.sqrt(ANN)
    panel["rv_30"] = r.rolling(30, min_periods=30).std() * np.sqrt(ANN)
    lv = {f"slog1p_{c}": signed_log1p(panel[c]) for c in LEVEL_COLUMNS if c in panel.columns}
    panel = pd.concat([panel, pd.DataFrame(lv, index=panel.index)], axis=1)

    if start is not None:
        panel = panel.loc[pd.Timestamp(start):]
    if end is not None:
        panel = panel.loc[:pd.Timestamp(end)]
    assert panel.index.is_monotonic_increasing and panel.index.is_unique
    return panel


def coverage_report(panel: pd.DataFrame) -> pd.DataFrame:
    """Per-column first/last valid date, n obs and % missing (over panel's full index)."""
    rows = []
    for c in panel.columns:
        s = panel[c]
        rows.append({
            "column": c,
            "first": s.first_valid_index(),
            "last": s.last_valid_index(),
            "n_obs": int(s.notna().sum()),
            "pct_missing": 100.0 * float(s.isna().mean()),
        })
    return pd.DataFrame(rows).set_index("column")


def forward_log_return(log_price: pd.Series, h: int) -> pd.Series:
    """y_t = log P_{t+h} - log P_t  (uses prices strictly AFTER t; label only, never a feature)."""
    return (log_price.shift(-h) - log_price).rename(f"logret_fwd_{h}")


